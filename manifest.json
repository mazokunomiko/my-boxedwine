{
  "manifest_version": 3,
  "name": "Local Boxedwine Emulator",
  "version": "1.0",
  "description": "Runs Boxedwine locally bypassing local file blocks",
  "action": {
    "default_title": "Launch Boxedwine"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
